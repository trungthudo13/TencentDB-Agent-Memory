# Each member configures these locally, never in the shared server .env.
# Use server root URLs without /v3. Replace rag.example.com with your server.
MEMORY_CORE_API_URL=https://memory.rag.example.com
KNOWLEDGE_API_URL=https://knowledge.rag.example.com
MCP_SERVICE_ID=default
MCP_TEAM_ID=your-team-id
MCP_AGENT_ID=your-agent-id
MCP_USER_ID=your-user-id
# Optional: required only when the corresponding API enables Bearer auth.
# MEMORY_CORE_API_TOKEN is the trusted gateway credential, not a member login key.
MEMORY_CORE_API_TOKEN=
KNOWLEDGE_API_TOKEN=
