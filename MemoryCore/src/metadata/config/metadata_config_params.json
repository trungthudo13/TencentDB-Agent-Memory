{
  "version": "1",
  "modules": [
    {
      "module": "quota",
      "description": "Instance quota settings",
      "params": [
        {
          "param_name": "max_users_per_instance",
          "param_value": "500",
          "description": "Maximum users per instance",
          "allowed_scopes": ["global"]
        },
        {
          "param_name": "max_teams_per_instance",
          "param_value": "100",
          "description": "Maximum teams per instance",
          "allowed_scopes": ["global"]
        }
      ]
    },
    {
      "module": "asset_type",
      "description": "AssetType resource availability",
      "params": [
        {
          "param_name": "skill.enabled",
          "param_value": "1",
          "description": "Allow Skill assets",
          "allowed_scopes": ["global", "user"]
        },
        {
          "param_name": "llm_wiki.enabled",
          "param_value": "1",
          "description": "Allow LLM Wiki assets",
          "allowed_scopes": ["global", "user"]
        },
        {
          "param_name": "code_graph.enabled",
          "param_value": "1",
          "description": "Allow Code Graph assets",
          "allowed_scopes": ["global", "user"]
        },
        {
          "param_name": "chat_memory.enabled",
          "param_value": "1",
          "description": "Allow Chat Memory assets",
          "allowed_scopes": ["global", "user"]
        }
      ]
    }
  ]
}
