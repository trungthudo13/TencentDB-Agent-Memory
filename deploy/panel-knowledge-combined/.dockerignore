# Ignore rules for the panel-knowledge-combined image context.
#
# build.sh copies panel/ (team-memory-control) and knowledge/ (services/knowledge)
# with rsync into a temporary context where these rules apply.
# Exclude sensitive configuration, internal information, and large files from the image.

# Deployment-specific configuration: mount at runtime; never include in images.
# metadata-instances.json contains the Core Bearer token; see the Panel deployment README.
panel/config/metadata-instances.json
panel/config/*.yaml
panel/config/*.yml
panel/.env
panel/.env.*
knowledge/.env
knowledge/.env.*

# Documentation is not required at runtime and may reference internal paths.
# Exclude both docs/ directories. The only required runtime specification is knowledge/openapi.yaml
# at the package root (read by src/server.ts for Swagger UI), so it remains included.
panel/docs/
knowledge/docs/

# Test scripts contain hardcoded internal paths and are not required at runtime.
panel/tests/
panel/e2e-*.sh
knowledge/__tests__/
knowledge/bin/e2e-*.sh

# Dependencies and build artifacts
**/node_modules
**/dist
**/build
**/.git
**/logs
**/*.log
**/data/
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite

# Editor and OS files
**/.DS_Store
**/.idea/
**/.vscode/
**/*.swp
**/*.swo
**/.iwiki
**/.codebuddy
