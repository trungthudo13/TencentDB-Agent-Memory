# Deployment variables for docker/docker-compose.yml.
# Copy this file to .env and replace REPLACE_ME before starting.
# Shared variable names follow deploy/global-images/.env.example.
# MEMORY_LLM_* is shared by MemoryCore and KnowledgeBase.


# Host ports. Use 0.0.0.0 to allow connections from other machines.
BIND_ADDRESS=127.0.0.1
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8421
LOG_LEVEL=info

# MongoDB for MemoryCore; accessible through the internal Compose network.
# KnowledgeBase uses SQLite in its persistent data volume.
MONGODB_DATABASE=tdai_memory

# ── Memory group: LLM called internally by memory + memory-hub ───────────────
# Used for memory embedding/summarization and knowledge wiki ingestion/
# summarization in memory-hub.
MEMORY_LLM_BASE_URL=REPLACE_ME              # Example: https://api.deepseek.com/v1
MEMORY_LLM_API_KEY=REPLACE_ME               # Example: sk-xxxxxxxx
MEMORY_LLM_MODEL=REPLACE_ME                 # Example: deepseek-chat
MEMORY_LLM_PROTOCOL=openai                  # openai | anthropic

# ── memory-core internal credentials ────────────────────────────────────────
# Administrative credential for the Gateway's Bearer authentication layer.
#   Empty (default) — Disables the Bearer gate for a zero-configuration local setup.
#                     Proxy auth/sessionInit can connect directly to memory-core
#                     only with this configuration; see the comments at the top
#                     of start-memory-core.sh.
#   Nonempty        — All requests must include `Authorization: Bearer <key>`.
#                     Proxy currently does not send this header, so its
#                     auth/sessionInit requests will fail.
# For production, fix the proxy integration before enabling a nonempty key.
MEMORY_CORE_GATEWAY_API_KEY=

# Knowledge write/admin endpoints require this Bearer key when configured.
# Compose does not generate a key automatically; set it explicitly if needed.
KNOWLEDGE_SERVICE_KEY=

# Compose-specific setting passed directly to MemoryCore.
# Replace with a random string and keep it unchanged across deployments.
TDAI_PASSWORD_PEPPER=REPLACE_ME

# Agent-accessible KnowledgeBase URL; must end in /v3.
# Replace localhost with the server address when accessing remotely.
# Update the port if KNOWLEDGE_PORT changes.
KNOWLEDGE_PUBLIC_BASE_URL=http://knowledgebase:8421/v3

# MemoryPanel callback URL reachable from KnowledgeBase on the Compose network.
# The callback path is appended automatically.
TMC_CALLBACK_URL=http://memory-panel:8123
