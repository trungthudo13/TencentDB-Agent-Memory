# Optional outbound HTTP proxy for MemoryProxy.
# Copy to .env.proxy and set your network's proxy address.
# Node fetch must explicitly opt in to environment proxy settings.
NODE_USE_ENV_PROXY=1
HTTP_PROXY=http://proxy.hcm.fpt.vn:80
HTTPS_PROXY=http://proxy.hcm.fpt.vn:80
http_proxy=http://proxy.hcm.fpt.vn:80
https_proxy=http://proxy.hcm.fpt.vn:80

# Keep Docker service traffic and local domains off the outbound proxy.
NO_PROXY=localhost,127.0.0.1,memory,knowledgebase,memory-proxy,memory-acp,memory-panel,mongodb,.vnebiz.local
no_proxy=localhost,127.0.0.1,memory,knowledgebase,memory-proxy,memory-acp,memory-panel,mongodb,.vnebiz.local
